# ---------------------------------------------------------------------------
# ÉcoMiam Backend — variables d'environnement
# Copie ce fichier en ".env" et remplis les valeurs (voir docs/SETUP.md pour
# savoir où récupérer chaque clé).
# ---------------------------------------------------------------------------

# Port du serveur (Render/Railway le fournissent automatiquement, sinon 3000)
PORT=3000
# "production" active les garde-fous stricts (voir server.js)
NODE_ENV=development

# --- Google Gemini (génération de recettes + vision pour le scan frigo) ----
# Clé gratuite sur https://aistudio.google.com/app/apikey (compte Google
# suffit, pas de carte bancaire nécessaire pour le tier gratuit).
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Modèle texte utilisé pour générer les recettes (JSON structuré)
GEMINI_TEXT_MODEL=gemini-2.5-flash
# Modèle utilisé pour le scan du frigo (Gemini est multimodal nativement)
GEMINI_VISION_MODEL=gemini-2.5-flash
# Modèle utilisé pour générer les VRAIES photos de recettes (Nano Banana).
# ~0.039$/image, gratuit jusqu'à un quota quotidien généreux sur AI Studio.
# Vérifie le nom le plus récent sur https://ai.google.dev/gemini-api/docs/models
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# Espacement minimum (ms) entre deux appels Gemini, tous utilisateurs
# confondus — protège ton quota gratuit contre le "spam" (plusieurs
# utilisateurs qui cliquent en même temps). 4200ms = ~14 req/min max.
# S'applique aussi à la génération d'images (même file d'attente).
GEMINI_MIN_INTERVAL_MS=6500

# Pour le dev / premier remplissage de la banque de recettes : passe direct
# par Pexels au lieu de Gemini pour les photos (beaucoup plus rapide, pas de
# risque de rate-limit). Repasse à "false" quand tu voudras les vraies
# photos IA cohérentes pour la prod.
SKIP_GEMINI_IMAGE_GEN=true

# --- Pexels (repli photo UNIQUEMENT si la génération Gemini échoue) --------
# Récupérée gratuitement sur https://www.pexels.com/api/
# (tu en as peut-être déjà une pour ton pipeline vidéo Hors Champ)
PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase (base de données + auth + statut PRO + STOCKAGE DES IMAGES) --
# Project Settings > API sur https://app.supabase.com
# Le bucket Storage "recipe-images" est créé automatiquement au démarrage du
# serveur (public, pour être servi direct à l'app mobile).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# La clé "service_role" (jamais exposée côté mobile !) — utilisée uniquement
# côté backend pour écrire dans la base sans passer par les policies RLS.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- RevenueCat (webhook de synchronisation des abonnements) --------------
# REST API key "Secret" trouvable sur https://app.revenuecat.com > Project > API Keys
REVENUECAT_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Chaîne secrète que tu choisis toi-même et que tu colles aussi dans
# RevenueCat > Integrations > Webhooks > "Authorization header"
REVENUECAT_WEBHOOK_SECRET=choisis-une-longue-chaine-aleatoire

# --- Sentry (monitoring d'erreurs, optionnel mais recommandé en prod) -----
# Crée un projet Node sur https://sentry.io (gratuit jusqu'à 5k erreurs/mois)
SENTRY_DSN=

# --- CORS -------------------------------------------------------------------
# En prod, restreins aux origines de ton app (séparées par des virgules).
# Laisse "*" en dev.
CORS_ORIGIN=*

# --- Google Sign-In natif / Protection multicompte (RISC) ------------------
# Voir GOOGLE_SIGNIN_SETUP.md et RISC_SETUP.md pour la procédure complète.
GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_RISC_SERVICE_ACCOUNT_KEY_PATH=./risc-service-account.json
RISC_RECEIVER_URL=https://ton-backend.onrender.com/api/webhooks/risc
